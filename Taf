função local CopiarTexto(Texto)
    sucesso local = falso
    if setclipboard then pcall(setclipboard, Texto) sucesso = true
    elseif toclipboard then pcall(toclipboard, Texto) sucesso = true
    senão se set_clipboard então pcall(set_clipboard, Texto) sucesso = verdadeiro
    fim
    
    Se tiver sucesso, então
        WindUI:Notify({ Type = "Originalmente", Title = "Copiado!", Content = "Texto copiado." })
    outro
        WindUI:Notify({ Type = "Originalmente", Title = "Erro", Content = "Seu executor não suporta copiar." })
    fim
