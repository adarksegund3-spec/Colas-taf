local FPSTag = Window:Tag({ Title = "FPS: 0", Color = Color3.fromRGB(100, 150, 255) })
local RunService = jogo:GetService("RunService")
local lastUpdate = tick()
local frameCount = 0

RunService.RenderStepped:Connect(function()
    Contagem de quadros = Contagem de quadros + 1
    local agora = tick()
    se agora - últimaAtualização >= 1 então
        local fps = math.floor(frameCount / (agora - últimaAtualização))
        FPSTag:SetTitle("FPS: " .. fps)

        se fps >= 50 então FPSTag:SetColor(Color3.fromRGB(0, 255, 0))
        senão se fps >= 30 então FPSTag:SetColor(Color3.fromRGB(255, 200, 0))
        senão FPSTag:SetColor(Color3.fromRGB(255, 0, 0)) fim

        frameCount = 0
        últimaAtualização = agora
    fim
fim)